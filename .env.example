POSTGRES_USER=appsec
POSTGRES_DB=appsec_ctf

# Логин первого админа (пароль генерируется автоматически при первом деплое)
ADMIN_USERNAME=admin-ussc

# JWT TTL (минуты), по умолчанию 8 часов
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Публичный URL не нужен при доступе через Caddy (same-origin /api)
NEXT_PUBLIC_API_URL=

DOMAIN=localhost
ACME_EMAIL=admin@localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# Cookie Secure=true только за реальным HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,https://localhost:8443,http://127.0.0.1:8080,https://127.0.0.1:8443,http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14
ENVIRONMENT=production
