# Database
POSTGRES_USER=appsec
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=appsec_ctf

# API
SECRET_KEY=change_me_to_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Public URL (leave empty to use same-origin /api via Caddy)
NEXT_PUBLIC_API_URL=

# HTTPS / Caddy
# localhost → Caddy выдаст локальный сертификат
# example.com → Let's Encrypt (нужен публичный DNS на сервер)
DOMAIN=localhost
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Backups (cron expression, UTC)
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14
